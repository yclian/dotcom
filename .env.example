# ==============================================================================
# yclian.com Environment Template
# ==============================================================================
# Copy this file to .env and supply your personal Cloudflare configuration values.
#
# cp .env.example .env

# Cloudflare API Token
# Generate at: https://dash.cloudflare.com/profile/api-tokens
# Required Token Permissions:
#   - Zone:DNS (Edit) - All zones or specific zone 'yclian.com'
#   - Account:Cloudflare Pages (Edit)
#   - Zone:Zone (Read)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID
# Found on the right sidebar of the Cloudflare Account Home / Overview page,
# or under Workers & Pages in the Cloudflare Dashboard URL.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare Zone ID for yclian.com
# Found on the Overview page of the 'yclian.com' zone in your Cloudflare dashboard
# once the domain is added.
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
